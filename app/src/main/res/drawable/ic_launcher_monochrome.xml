        android:pathData="M54,25L54,38M54,70L54,83M25,54L38,54M70,54L83,54"
        android:strokeColor="#3DFF8B"
        android:strokeAlpha="0.55"
        android:strokeLineCap="round"
        android:strokeWidth="2.4" />

    <!-- target -->
    <path
        android:pathData="M54,54m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0"
        android:strokeColor="#3DFF8B"
        android:strokeAlpha="0.7"
        android:strokeWidth="1.6" />

    <!-- bubble -->
    <path
        android:fillColor="#3DFF8B"
        android:pathData="M54,54m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0" />
    <path
        android:fillColor="#B8FFD6"
